# =============================================================================
# WWI-Fabric-DataPlatform .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Virtual environments
venv/
ENV/
env/
.venv/

# -----------------------------------------------------------------------------
# IDE and Editors
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Azure & Microsoft
# -----------------------------------------------------------------------------
# Azure credentials
*.azureauth
.azure/
azure.json

# Azure Functions
local.settings.json
.python_packages/

# Power BI
*.pbix.bak
*.pbit.bak

# -----------------------------------------------------------------------------
# Data Files (don't commit large data)
# -----------------------------------------------------------------------------
*.parquet
!data/sample-files/**/*.csv
!data/sample-files/**/*.json
!data/schemas/**/*.json
!src/config/**/*.json

# Database files
*.mdf
*.ldf
*.bak
*.trn

# -----------------------------------------------------------------------------
# Secrets and Configuration
# -----------------------------------------------------------------------------
# Environment files
.env
.env.local
.env.*.local
*.env

# Secrets
secrets/
**/secrets.*
*.pem
*.key
*.crt
*.pfx

# Connection strings
connections.json
connection-strings.json

# -----------------------------------------------------------------------------
# Build and Output
# -----------------------------------------------------------------------------
# Build outputs
bin/
obj/
out/
target/

# Logs
logs/
*.log
npm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp

# -----------------------------------------------------------------------------
# Fabric Specific
# -----------------------------------------------------------------------------
# Fabric workspace state (managed by Fabric)
.pbi/
.platform

# Notebook checkpoints
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Bicep
*.bicep.lock.json

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# Test results
TestResults/
test-results/
coverage/
*.trx

# -----------------------------------------------------------------------------
# Documentation Build
# -----------------------------------------------------------------------------
site/
_site/
.docusaurus/

# -----------------------------------------------------------------------------
# Project Specific Exclusions
# -----------------------------------------------------------------------------
# Local development overrides
*.local.json
*-local.*

# Scratch files
scratch/
sandbox/
*.scratch.*
